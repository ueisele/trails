# Settings for `command make deploy`. Copy to .env (git-ignored) and fill in.
#
# NONE of these may be committed: this repository is public, and the first four identify the
# Cloudflare account even though they are not credentials. Every value is printed by
# `just deploy-env` in the trails-map module of the private infrastructure repo.

# Where the map goes — outputs `bucket` and `s3_endpoint`.
TRAILS_MAP_BUCKET=
TRAILS_MAP_S3_ENDPOINT=

# Where it is served, and the zone to purge — outputs `hostname` and `zone_id`.
TRAILS_MAP_HOSTNAME=
TRAILS_MAP_ZONE_ID=

# R2 API token, Object Read & Write on that bucket only. Named `deploy-trails-map`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare API token with Zone -> Cache Purge -> Purge. Named `deploy-trails-map-purge`.
# Only needed for the purge; `make deploy ARGS="--no-purge"` works without it.
CLOUDFLARE_API_TOKEN=
